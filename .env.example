# Configure privately in .env. Never commit credentials.
QLOO_API_KEY=
OPENAI_API_KEY=
# Supported snapshot: gpt-5.4-mini-2026-03-17. Set only after choosing it.
OPENAI_MODEL=
# Set only after authorizing paid test usage. Reservations persist across restarts.
OPENAI_TEST_BUDGET_USD=
# Local ledger. Production requires persistent storage OR the remote ledger below.
OPENAI_BUDGET_FILE=.local/openai-budget.json
# Free hosts have ephemeral files. Use a dedicated Upstash Free database there.
# All three fields must be configured together; no fallback or automatic reset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OPENAI_BUDGET_REDIS_KEY=
# Count is a conservative workflow reservation per hour, not a Qloo HTTP quota.
# Each harness workflow may make multiple Qloo requests. Set from event limits.
QLOO_HOURLY_WORKFLOW_LIMIT=30
PORT=4310
HOST=127.0.0.1
